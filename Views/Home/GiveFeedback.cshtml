@model Practical7.Models.Feedback

@{
    ViewBag.Title = "Give Feedback";
}

<h2>Student Feedback Portal</h2>

<div class="feedback-form">

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>Enrollment Number</label>
            @Html.TextBoxFor(m => m.EnrollmentNumber, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.EnrollmentNumber)
        </div>

        <div class="form-group">
            <label>Student Name</label>
            @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.StudentName)
        </div>

        <div class="form-group">
            <label>Subject</label>
            @Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Subject)
        </div>

        <div class="form-group">
            <label>Rating</label>
            @Html.TextBoxFor(m => m.Rating, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Rating)
        </div>

        <div class="form-group">
            <label>Comment</label>
            @Html.TextAreaFor(m => m.Comment, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <input type="submit" value="Submit Feedback" class="submit-btn" />
        </div>
    }

    @Html.ActionLink("Back to Home", "Index", "Home")

</div>